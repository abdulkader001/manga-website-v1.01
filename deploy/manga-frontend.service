[Unit]
Description=Manga Website Frontend (Nginx)
After=network.target
Requires=network.target

[Service]
# Working directory points to where your built frontend lives
WorkingDirectory=/var/www/manga/frontend

# Run Nginx serving the frontend build
ExecStart=/usr/sbin/nginx -g 'daemon off;' -c /etc/nginx/manga-site.conf
ExecReload=/bin/kill -s HUP $MAINPID

# Ensure Nginx can find static files
Environment="NGINX_CONFIG=/etc/nginx/manga-site.conf"

Restart=always
RestartSec=5

User=www-data
Group=www-data

# Logging
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=manga-frontend

[Install]
WantedBy=multi-user.target
