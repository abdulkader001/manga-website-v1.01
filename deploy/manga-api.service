[Unit]
Description=Manga Website API (Gunicorn/Uvicorn)
After=network.target redis.service postgresql.service
Requires=redis.service

[Service]
# Repo root -- the "backend_fastapi" package is a subdirectory of this, and
# start_backend.sh resolves deploy/gunicorn.conf.py relative to it (matching
# the container's WORKDIR=/app).
WorkingDirectory=/var/www/manga

EnvironmentFile=/var/www/manga/.env
# Runs gunicorn -c deploy/gunicorn.conf.py -k uvicorn.workers.UvicornWorker
# backend_fastapi.app.main:app, after waiting for dependent services and
# migrations (see backend_fastapi/scripts/start_backend.sh).
ExecStart=/usr/bin/env sh /var/www/manga/backend_fastapi/scripts/start_backend.sh

Restart=always
RestartSec=5

# Run as non-root for safety
User=manga
Group=manga

# Logging
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=manga-api

[Install]
WantedBy=multi-user.target
