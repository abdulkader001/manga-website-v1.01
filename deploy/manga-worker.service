[Unit]
Description=Manga Website Celery Worker
After=network.target redis.service
Requires=redis.service

[Service]
# Repo root -- the "backend_fastapi" package is a subdirectory of this, and
# Celery's "-A backend_fastapi..." app path only resolves when the process
# is launched from here (matching the container's WORKDIR=/app).
WorkingDirectory=/var/www/manga

# Start Celery worker via the shared startup script so it picks up the same
# --queues routing and readiness gate as the docker-compose deployment.
# Runs `celery -A backend_fastapi.app.core.celery_app:celery_app worker`.
ExecStart=/usr/bin/env sh /var/www/manga/backend_fastapi/scripts/start_celery_worker.sh

# Load env variables (DB_URL, REDIS_URL, SECRET_KEY, etc.)
EnvironmentFile=/var/www/manga/.env

Restart=always
RestartSec=5

# Run as non-root for safety
User=manga
Group=manga

# Logging
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=manga-worker

[Install]
WantedBy=multi-user.target
