{
  "name": "manga-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full-stack Manga Reader web application with OCR translation and management tools",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "start": "NODE_ENV=production tsx server.ts",
    "backend": "uvicorn backend_fastapi.app.main:app --host 127.0.0.1 --port 8000",
    "test": "vitest run"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "@tanstack/react-query": "5.104.0",
    "express": "4.22.3",
    "material-icons": "1.13.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/express": "4.17.25",
    "@types/node": "22.20.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
