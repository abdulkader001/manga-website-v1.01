# ======================================
# .dockerignore for Manga Website Backend
# Keeps your Docker image clean & small
# ======================================

# -------------------------
# Git / IDE metadata
# -------------------------
.git
.gitignore
.vscode
.idea

# -------------------------
# Python build and cache files
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.db
*.sqlite3
*.egg-info/
*.egg
build/
dist/
.venv/
venv/
env/
ENV/

# -------------------------
# Node.js / Frontend files (if accidentally copied)
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# -------------------------
# OS-generated files
# -------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# -------------------------
# Environment / secrets
# -------------------------
.env
.env.local
*.local
*.secret
*.key
*.pem
*.crt
