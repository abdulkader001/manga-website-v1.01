[Unit]
Description=Manga Website Celery Worker (picture compression)
After=network.target redis.service
Requires=redis.service

[Service]
# Same layout as manga-worker.service. This worker only consumes the
# `compress` queue (download + WebP compression of chapter pictures), so a big
# import cannot delay new-chapter checks on the scrape queue (roadmap item 7).
WorkingDirectory=/var/www/manga
ExecStart=/usr/bin/env sh /var/www/manga/backend_fastapi/scripts/start_celery_worker.sh

EnvironmentFile=/var/www/manga/.env
# After EnvironmentFile so these win over any value set in .env.
Environment=CELERY_QUEUES=compress
Environment=CELERY_CONCURRENCY=2

Restart=always
RestartSec=5

User=manga
Group=manga

StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=manga-worker-compress

[Install]
WantedBy=multi-user.target
