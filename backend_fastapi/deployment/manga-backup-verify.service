[Unit]
Description=Manga Website weekly backup restore test
After=network.target postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/var/www/manga
# Backup settings and database credentials; keep the encryption passphrase
# here (mode 600) and never in this unit or the crontab.
EnvironmentFile=/etc/manga/backup.env
ExecStart=/usr/bin/env bash /var/www/manga/backend_fastapi/deployment/run_backup_verification.sh
User=manga
Group=manga
SyslogIdentifier=manga-backup-verify
# A non-zero exit marks the unit failed; alert on that (for example with
# OnFailure= or your monitoring of failed systemd units).
